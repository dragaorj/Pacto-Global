---
import { Picture } from 'astro:assets';
import Markdoc from '@markdoc/markdoc';
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import PublicationCard, { type Tema, temas } from '../../components/cards/PublicationCard.astro';
import { getPublicacoes, formatDataLonga } from '../../lib/publicacoes';

export async function getStaticPaths() {
  const pubs = await getPublicacoes();
  return pubs.map((p) => ({ params: { slug: p.slug }, props: { pub: p, outras: pubs.filter((o) => o.slug !== p.slug) } }));
}

const { pub, outras } = Astro.props;
const { node } = await pub.conteudo();
const html = Markdoc.renderers.html(Markdoc.transform(node as any));
const cor = temas[pub.tema as Tema]?.color ?? 'var(--color-action)';
const site = Astro.site ? new URL(pub.href, Astro.site).toString() : pub.href;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(site)}`;
const downloadLabel = pub.exigeCadastro ? 'Baixar publicação' : pub.tipo === 'infografico' ? 'Baixar infográfico (PDF)' : 'Baixar PDF';
---

<Base title={pub.titulo} description={pub.resumo} path={pub.href}>
  <article class="pub container">
    <nav class="crumbs" aria-label="Você está em">
      <a href="/">Início</a>
      <span aria-hidden="true">/</span>
      <a href="/publicacoes">Publicações</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{pub.titulo}</span>
    </nav>

    <div class="pub__grid">
      <div class="pub__main">
        <header class="pub__head">
          <div class="pub__tags">
            <SectionLabel>{pub.tipoLabel}</SectionLabel>
            <Badge variant="pill" color={cor}>{pub.temaLabel}</Badge>
          </div>
          <h1>{pub.titulo}</h1>
          <p class="pub__meta">
            {pub.data && <time datetime={pub.data}>{formatDataLonga(pub.data)}</time>}
            {pub.data && <span aria-hidden="true">·</span>}
            <span>{pub.idioma}</span>
          </p>
          {pub.resumo && <p class="pub__lead">{pub.resumo}</p>}
          {
            pub.link && (
              <Button href={pub.link} size="lg" iconRight="download" external class="pub__mcta">
                {downloadLabel}
              </Button>
            )
          }
        </header>

        {
          pub.paginas.length > 0 && (
            <section class="pub__pages" aria-label="Infográfico">
              {pub.paginas.map((img, i) => (
                <figure>
                  <Picture
                    src={img}
                    alt={`${pub.titulo} — página ${i + 1} de ${pub.paginas.length} do infográfico. O conteúdo está disponível em texto abaixo.`}
                    formats={['avif', 'webp']}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 1200px) 760px, (min-width: 768px) 66vw, 100vw"
                    quality={72}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                  />
                </figure>
              ))}
            </section>
          )
        }

        <section class="prose" aria-label={pub.paginas.length ? 'Conteúdo do infográfico em texto' : 'Sobre a publicação'}>
          {pub.paginas.length > 0 && <p class="prose__note"><Icon name="file" size={16} /> Versão em texto do infográfico</p>}
          <Fragment set:html={html} />
        </section>
      </div>

      <aside class="pub__aside">
        <div class="pub__card">
          {
            pub.capa && (
              <Picture src={pub.capa} alt="" formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(min-width: 1024px) 360px, 100vw" quality={70} class="pub__cover" loading="eager" />
            )
          }
          {
            pub.link && (
              <Button href={pub.link} size="lg" iconRight="download" external class="pub__btn">
                {downloadLabel}
              </Button>
            )
          }
          {pub.exigeCadastro && <p class="pub__hint">Download gratuito mediante um breve cadastro.</p>}
          <dl class="pub__facts">
            <div>
              <dt>Tipo</dt>
              <dd>{pub.tipoLabel}</dd>
            </div>
            <div>
              <dt>Tema</dt>
              <dd>{pub.temaLabel}</dd>
            </div>
            {
              pub.data && (
                <div>
                  <dt>Data</dt>
                  <dd>{formatDataLonga(pub.data)}</dd>
                </div>
              )
            }
            <div>
              <dt>Idioma</dt>
              <dd>{pub.idioma}</dd>
            </div>
          </dl>
          <div class="pub__share">
            <span>Compartilhar</span>
            <a href={shareLinkedIn} target="_blank" rel="noopener noreferrer" class="share" aria-label="Compartilhar no LinkedIn"><Icon name="linkedin" size={18} /></a>
            <button type="button" class="share" data-copy={site} aria-label="Copiar link da publicação"><Icon name="clipboard" size={18} /></button>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <section class="others" aria-labelledby="outras-titulo">
    <div class="container">
      <div class="others__head">
        <h2 id="outras-titulo">Outras publicações</h2>
        <Button href="/publicacoes" variant="outline" size="lg" iconRight="arrow-right">Ver todas</Button>
      </div>
      <ul role="list" class="others__grid">
        {
          outras.map((o) => (
            <li>
              <PublicationCard title={o.titulo.toUpperCase()} theme={o.tema as Tema} language={o.idioma} href={o.href} image={o.capa} linkLabel="Ler publicação" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.setAttribute('aria-label', 'Link copiado!');
        b.classList.add('is-done');
        setTimeout(() => {
          b.setAttribute('aria-label', 'Copiar link da publicação');
          b.classList.remove('is-done');
        }, 2000);
      } catch {}
    })
  );
</script>

<style>
  .pub {
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: var(--section-y);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-10);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--color-text);
    max-width: 40ch;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .pub__grid {
    display: grid;
    gap: var(--space-10);
  }
  .pub__main {
    display: grid;
    gap: var(--space-10);
    min-width: 0;
  }
  .pub__head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .pub__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  h1 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.5rem);
    font-weight: var(--weight-semibold);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .pub__meta {
    display: flex;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .pub__lead {
    font-size: var(--text-lead);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    max-width: 68ch;
  }
  .pub__pages {
    display: grid;
    gap: 16px;
  }
  .pub__pages figure {
    margin: 0;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
  }
  .pub__pages :global(picture),
  .pub__pages :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* corpo do texto */
  .prose {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-body);
  }
  .prose__note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-6);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .prose :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    letter-spacing: -0.015em;
  }
  .prose :global(p) {
    margin-bottom: 1em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.5em;
    margin: 0 0 1.2em;
    padding-left: 1.3em;
  }
  .prose :global(li::marker) {
    color: var(--color-action);
  }
  .prose :global(strong) {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--gold-500);
    font-size: 1.25rem;
    font-weight: var(--weight-medium);
    line-height: 1.45;
    color: var(--color-text);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }

  /* lateral */
  .pub__card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius-3xl);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .pub__card :global(.pub__cover),
  .pub__card :global(.pub__cover img) {
    width: 100%;
    border-radius: var(--radius-xl);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
  }
  .pub__card :global(.pub__btn) {
    width: 100%;
  }
  .pub__hint {
    margin-top: -8px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
  .pub__facts {
    display: grid;
    margin: 0;
  }
  .pub__facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .pub__facts dt {
    color: var(--color-text-muted);
  }
  .pub__facts dd {
    margin: 0;
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-align: right;
  }
  .pub__share {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .pub__share span {
    margin-right: auto;
  }
  .share {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }
  .share:hover,
  .share.is-done {
    background: var(--color-bg-muted);
    color: var(--color-action);
  }

  .pub__head :global(.pub__mcta) {
    width: 100%;
  }
  @media (min-width: 1024px) {
    .pub__head :global(.pub__mcta) {
      display: none;
    }
    .pub__grid {
      grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
      gap: clamp(32px, 4vw, 80px);
      align-items: start;
    }
    .pub__aside {
      position: sticky;
      top: calc(var(--header-h) + 8px);
    }
  }

  /* outras */
  .others {
    padding-block: var(--section-y);
    background: var(--color-bg-subtle);
  }
  .others__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: var(--space-10);
  }
  .others__head h2 {
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    letter-spacing: -0.025em;
  }
  .others__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0;
  }
  .others__grid > li {
    display: grid;
  }
  @media (min-width: 1024px) {
    .others__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
</style>
