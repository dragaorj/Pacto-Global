---
/**
 * Painel de acessibilidade: tamanho de texto, alto contraste, links destacados,
 * espaçamento de leitura, pausar animações, cursor grande, correção para daltonismo
 * e tradutor de Libras (VLibras, carregado só se ativado).
 */
import Icon from '../ui/Icon.astro';
import IconButton from '../ui/IconButton.astro';
import { type Lang, useT } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const toggles = [
  ['contrast', t('a11y.contrast')],
  ['links', t('a11y.links')],
  ['spacing', t('a11y.spacing')],
  ['motion', t('a11y.motion')],
  ['cursor', t('a11y.cursor')],
] as const;
const cb = [
  ['', t('a11y.cb.none')],
  ['protanopia', t('a11y.cb.protanopia')],
  ['deuteranopia', t('a11y.cb.deuteranopia')],
  ['tritanopia', t('a11y.cb.tritanopia')],
  ['grayscale', t('a11y.cb.grayscale')],
] as const;
---

<dialog class="a11y" data-dialog="a11y" aria-labelledby="a11y-title">
  <div class="a11y__top">
    <h2 id="a11y-title"><Icon name="accessibility" size={24} strokeWidth={1.6} /> {t('a11y.title')}</h2>
    <IconButton icon="close" label={t('a11y.close')} size="lg" variant="soft" data-close />
  </div>
  <div class="a11y__body">
    <p class="a11y__intro">{t('a11y.intro')}</p>

    <fieldset class="group">
      <legend>{t('a11y.text')}</legend>
      <div class="seg">
        <button type="button" data-a11y-text="-1" aria-label={t('a11y.textDown')}>A−</button>
        <button type="button" data-a11y-text="0" aria-label={t('a11y.textReset')}>A</button>
        <button type="button" data-a11y-text="1" aria-label={t('a11y.textUp')}>A+</button>
        <button type="button" data-a11y-text="2" aria-label={`${t('a11y.textUp')} 2`}>A++</button>
      </div>
    </fieldset>

    <div class="grid">
      {
        toggles.map(([key, label]) => (
          <button type="button" class="opt" data-a11y-toggle={key} aria-pressed="false">
            <span>{label}</span>
            <span class="switch" aria-hidden="true" />
          </button>
        ))
      }
    </div>

    <fieldset class="group">
      <legend>{t('a11y.colorblind')}</legend>
      <div class="chips">
        {
          cb.map(([key, label]) => (
            <button type="button" class="chip" data-a11y-cb={key} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>
    </fieldset>

    <button type="button" class="opt opt--wide" data-a11y-libras aria-pressed="false">
      <span>
        <strong>{t('a11y.libras')}</strong>
        <small>{t('a11y.librasHint')}</small>
      </span>
      <span class="switch" aria-hidden="true"></span>
    </button>

    <button type="button" class="reset" data-a11y-reset>{t('a11y.reset')}</button>
  </div>
</dialog>

<style>
  .a11y {
    margin: 0 0 0 auto;
    width: min(100vw, 440px);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .a11y::backdrop {
    background: rgb(10 15 30 / 0.5);
  }
  .a11y[open] {
    display: flex;
    flex-direction: column;
  }
  .a11y__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--gutter);
    border-bottom: 1px solid var(--color-border);
  }
  .a11y__top h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-h4);
  }
  .a11y__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6) var(--gutter);
    overflow-y: auto;
  }
  .a11y__intro {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .group {
    border: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  legend {
    margin-bottom: 10px;
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
  }
  .seg button {
    height: 40px;
    border-radius: var(--radius-full);
    font-weight: var(--weight-semibold);
  }
  .seg button[aria-pressed='true'] {
    background: var(--color-bg);
    box-shadow: 0 1px 3px rgb(16 24 40 / 0.12);
  }
  .grid {
    display: grid;
    gap: 8px;
  }
  .opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 12px 16px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border-strong);
    text-align: left;
    font-weight: var(--weight-medium);
  }
  .opt small {
    display: block;
    font-weight: var(--weight-regular);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .opt[aria-pressed='true'] {
    border-color: var(--color-action);
    background: color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .switch {
    position: relative;
    flex-shrink: 0;
    width: 44px;
    height: 26px;
    border-radius: 999px;
    background: var(--color-border-strong);
    transition: background-color var(--duration-base);
  }
  .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform var(--duration-base) var(--ease-out);
  }
  [aria-pressed='true'] .switch {
    background: var(--color-action);
  }
  [aria-pressed='true'] .switch::after {
    transform: translateX(18px);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    height: 40px;
    padding-inline: 16px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-primary-strong);
    border-color: var(--color-primary-strong);
    color: var(--white);
  }
  :global([data-theme='dark']) .chip[aria-pressed='true'] {
    background: var(--white);
    color: var(--navy-925);
  }
  .reset {
    height: 48px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    font-weight: var(--weight-semibold);
  }
</style>
