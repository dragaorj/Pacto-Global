---
/** Tile de Movimento — Figma: Card/Movimento. Ideal: passar o logotipo oficial em `logo`. */
interface Props {
  name: string;
  color?: string;
  logo?: string;
  href?: string;
}
const { name, color = 'var(--gold-500)', logo, href = '#' } = Astro.props;
---

<a class="mov-card" href={href} style={`--_c: ${color}`}>
  {
    logo ? (
      <img src={logo} alt={`Movimento ${name}`} loading="lazy" />
    ) : (
      <span class="mov-card__brand">
        <span class="mov-card__word">MOVIMENTO</span>
        <span class="mov-card__name">{name}</span>
      </span>
    )
  }
</a>

<style>
  .mov-card {
    display: grid;
    place-items: center;
    min-height: 104px;
    padding: var(--space-4);
    background: var(--color-bg-muted);
    border-top: 3px solid var(--_c);
    border-radius: var(--radius-2xl);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .mov-card:hover {
    transform: var(--lift-sm);
    box-shadow: var(--shadow-on-dark);
  }
  .mov-card img {
    max-height: 56px;
    width: auto;
  }
  .mov-card__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }
  .mov-card__word {
    font-size: var(--text-h5);
    color: var(--color-text-body);
    letter-spacing: 0.02em;
  }
  .mov-card__name {
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    color: var(--_c);
    text-transform: uppercase;
  }
</style>
