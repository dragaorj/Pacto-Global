---
/** Tile de logo de parceiro — Figma: Card/Parceiro */
interface Props {
  name: string;
  logo?: string;
  href?: string;
}
const { name, logo, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="partner" href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined}>
  {logo ? <img src={logo} alt={name} loading="lazy" /> : <span>{name}</span>}
</Tag>

<style>
  .partner {
    display: grid;
    place-items: center;
    min-height: 100px;
    padding: var(--space-4);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .partner img {
    max-height: 48px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.8;
    transition:
      filter var(--duration-base),
      opacity var(--duration-base);
  }
  .partner:hover img {
    filter: none;
    opacity: 1;
  }
</style>
