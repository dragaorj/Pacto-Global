---
/**
 * Selos/etiquetas.
 * variant: category (retangular, ex. "EVENTOS" vermelho no hero)
 *          pill (arredondado, ex. tema de publicação)
 *          soft (fundo translúcido, ex. "Português" sobre imagem)
 * color: qualquer cor CSS ou token, ex. "var(--tema-direitos-humanos)"
 */
interface Props {
  variant?: 'category' | 'pill' | 'soft';
  color?: string;
  class?: string;
}
const { variant = 'pill', color = 'var(--color-accent)', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, className]} style={`--_c: ${color}`}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .badge--category {
    background: var(--_c);
    color: var(--white);
    padding: 5px var(--space-3);
    border-radius: var(--radius-xs);
  }
  .badge--pill {
    background: var(--_c);
    color: var(--white);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }
  .badge--soft {
    background: rgb(0 0 0 / 0.45);
    color: var(--white);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    backdrop-filter: blur(6px);
    text-transform: none;
    letter-spacing: 0;
    font-weight: var(--weight-medium);
  }
</style>
