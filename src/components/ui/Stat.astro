---
/** Número de destaque (seção "Nossa magnitude"). */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon?: IconName;
  value: string;
  label: string;
  sublabel?: string;
  tone?: 'dark' | 'light';
}
const { icon, value, label, sublabel, tone = 'dark' } = Astro.props;
---

<div class:list={['stat', `stat--${tone}`]}>
  {icon && <Icon name={icon} size={22} class="stat__icon" />}
  <strong class="stat__value">{value}</strong>
  <span class="stat__label">{label}</span>
  {sublabel && <span class="stat__sub">{sublabel}</span>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .stat :global(.stat__icon) {
    margin-bottom: var(--space-4);
    color: var(--gold-500);
  }
  .stat__value {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: var(--weight-semibold);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-3);
  }
  .stat__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .stat__sub {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .stat--dark .stat__value,
  .stat--dark .stat__label {
    color: var(--white);
  }
  .stat--dark .stat__sub {
    color: var(--color-text-on-dark-muted);
  }
  .stat--light .stat__value,
  .stat--light .stat__label {
    color: var(--color-text);
  }
  .stat--light .stat__sub {
    color: var(--color-text-muted);
  }
</style>
