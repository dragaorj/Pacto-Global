---
/**
 * Botão / link com aparência de botão.
 * variant: primary (verde, CTA padrão) · accent (vermelho, hero) · light (branco, rodapé)
 *          outline (borda, fundo claro) · outline-light (borda, fundo escuro) · link (texto + seta)
 * size: sm · md · lg
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href?: string;
  /** cta: CTA principal ("Quero aderir") — degradê, halo e seta em círculo */
  variant?: 'primary' | 'cta' | 'accent' | 'light' | 'outline' | 'outline-light' | 'link';
  size?: 'sm' | 'md' | 'lg';
  iconLeft?: IconName;
  iconRight?: IconName;
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  iconLeft,
  iconRight,
  type = 'button',
  external = false,
  class: className,
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const Tag = href ? 'a' : 'button';
const iconSize = size === 'lg' ? 18 : size === 'sm' ? 14 : 16;
---

<Tag
  href={href}
  type={href ? undefined : type}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...rest}
>
  {iconLeft && <Icon name={iconLeft} size={iconSize} strokeWidth={2} />}
  <span><slot /></span>
  {
    iconRight &&
      (variant === 'cta' ? (
        <span class="btn__chip" aria-hidden="true">
          <Icon name={iconRight} size={16} strokeWidth={2.25} />
        </span>
      ) : (
        <Icon name={iconRight} size={iconSize} strokeWidth={2} />
      ))
  }
</Tag>

<style>
  .btn {
    --_bg: transparent;
    --_fg: var(--color-text);
    --_bd: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    color: var(--_fg);
    background: var(--_bg);
    border: 1.5px solid var(--_bd);
    border-radius: var(--radius-full);
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .btn:hover {
    transform: var(--lift-sm);
  }
  .btn:active {
    transform: none;
  }

  /* tamanhos — altura fixa + largura mínima: CTAs lado a lado ficam iguais */
  .btn--sm {
    font-size: var(--text-2xs);
    height: 32px;
    min-width: 120px;
    padding-inline: var(--space-3);
  }
  .btn--md {
    font-size: var(--text-xs);
    height: 40px;
    min-width: 160px;
    padding-inline: var(--space-5);
  }
  .btn--lg {
    font-size: var(--text-sm);
    height: 48px;
    min-width: 200px;
    padding-inline: var(--space-8);
  }
  .btn--link {
    min-width: 0;
  }

  /* variantes */
  .btn--primary {
    --_bg: var(--color-action);
    --_fg: var(--white);
  }
  .btn--primary:hover {
    --_bg: var(--color-action-hover);
  }
  .btn--accent {
    --_bg: var(--color-accent);
    --_fg: var(--white);
  }
  .btn--accent:hover {
    --_bg: var(--color-accent-hover);
  }
  .btn--light {
    --_bg: var(--white);
    --_fg: var(--navy-700);
  }
  .btn--light:hover {
    --_bg: var(--navy-100);
  }
  /* ---------- CTA principal ---------- */
  .btn--cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    gap: 14px;
    padding-inline: 24px 6px;
    --_fg: var(--white);
    background: linear-gradient(135deg, #34a58f 0%, var(--teal-600) 48%, #1d5c50 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 12px 32px -10px rgb(41 125 109 / 0.75);
  }
  .btn--cta.btn--lg {
    padding-inline: 24px 6px;
  }
  /* reflexo de luz que atravessa o botão no hover */
  .btn--cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.32) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform 700ms var(--ease-out);
  }
  .btn--cta:hover {
    transform: var(--lift-sm);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.32),
      0 0 0 4px rgb(41 125 109 / 0.18),
      0 16px 40px -10px rgb(41 125 109 / 0.85);
  }
  .btn--cta:hover::before {
    transform: translateX(120%);
  }
  .btn__chip {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--white);
    color: var(--teal-700);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .btn--md .btn__chip {
    width: 30px;
    height: 30px;
  }
  .btn--cta:hover .btn__chip {
    transform: rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn--cta::before {
      display: none;
    }
  }

  /* segue o tema: navy no claro, branco no escuro */
  .btn--outline {
    --_fg: var(--color-text);
    --_bd: color-mix(in srgb, var(--color-text) 85%, transparent);
  }
  .btn--outline:hover {
    --_bg: var(--color-text);
    --_fg: var(--color-bg);
  }
  .btn--outline-light {
    --_fg: var(--white);
    --_bd: rgb(255 255 255 / 0.5);
  }
  .btn--outline-light:hover {
    --_bg: var(--white);
    --_fg: var(--navy-700);
    --_bd: var(--white);
  }
  .btn--link {
    --_fg: var(--color-text);
    padding-inline: 0;
    letter-spacing: var(--tracking-wider);
  }
  .btn--link:hover {
    transform: none;
    --_fg: var(--color-action);
  }
  .btn--link :global(.icon) {
    transition: transform var(--duration-base) var(--ease-out);
  }
  .btn--link:hover :global(.icon:last-child) {
    transform: translateX(3px);
  }
</style>
