---
/**
 * Banner de destaque em tela cheia (Figma: Hero · New Home).
 * Slider acessível: botões numerados, pausa, teclado, autoplay que respeita "reduzir movimento".
 * Primeira imagem com prioridade alta (LCP); demais carregam depois.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { type Lang, useT } from '../../i18n/ui';

export interface Slide {
  categoria: string;
  titulo: string;
  destaque: string;
  descricao: string;
  link: string;
  video?: string;
  imagem?: ImageMetadata;
  posicao: string;
}
export interface Headline {
  title: string;
  meta: string;
  href: string;
  image?: ImageMetadata;
}
interface Props {
  lang: Lang;
  slides: Slide[];
  headlines: Headline[];
}
const { lang, slides, headlines } = Astro.props;
const t = useT(lang);
const pos: Record<string, string> = { center: '50% 40%', right: '78% 40%', left: '22% 40%' };
---

<section class="hero" data-hero aria-roledescription="carousel" aria-label={t('meta.title')}>
  <div class="hero__media" aria-hidden="true">
    {
      slides.map((s, i) => (
        <div class:list={['hero__bg', { 'is-active': i === 0 }]} data-bg data-pos={s.posicao}>
          {s.imagem && (
            <Picture
              src={s.imagem}
              alt=""
              formats={['avif', 'webp']}
              widths={[480, 768, 1080, 1440, 1920]}
              sizes="100vw"
              quality={68}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding={i === 0 ? 'sync' : 'async'}
              style={`object-position:${pos[s.posicao] ?? pos.center}`}
            />
          )}
        </div>
      ))
    }
    <div class="hero__shade"></div>
    <p class="hero__giant" data-giant>{t('hero.giant')}</p>
  </div>

  <div class="container hero__inner">
    <div class="hero__slides">
      {
        slides.map((s, i) => (
          <div
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} / ${slides.length}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i === 0 ? undefined : true}
          >
            <Badge variant="category">{s.categoria}</Badge>
            {i === 0 ? (
              <h1 class="hero__title">
                {s.titulo} <span>{s.destaque}</span>
              </h1>
            ) : (
              <h2 class="hero__title">
                {s.titulo} <span>{s.destaque}</span>
              </h2>
            )}
            <p class="hero__desc">{s.descricao}</p>
            <div class="hero__btns">
              <Button href={s.link} variant="accent" size="lg" iconRight="arrow-right">
                {t('cta.more')}
              </Button>
              {s.video && (
                <Button href={s.video} variant="outline-light" size="lg" iconRight="play" external>
                  {t('cta.video')}
                </Button>
              )}
            </div>
          </div>
        ))
      }
    </div>

    {
      slides.length > 1 && (
        <div class="hero__ctrl">
          <button class="hero__pause" type="button" data-hero-pause aria-label={t('hero.pause')} aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="i-pause"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="i-play"><path d="M8 5l11 7-11 7z" /></svg>
          </button>
          <ol role="list" class="hero__dots">
            {slides.map((_, i) => (
              <li>
                <button type="button" class:list={['hero__dot', { 'is-active': i === 0 }]} data-goto={i} aria-label={`${String(i + 1).padStart(2, "0")} – ${t("hero.goto")}`} aria-current={i === 0 ? 'true' : undefined}>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<div class="heads container">
  <ul role="list" class="heads__list">
    {
      headlines.map((h) => (
        <li>
          <a class="heads__item" href={h.href}>
            {h.image && <Picture src={h.image} alt="" formats={['avif', 'webp']} widths={[112]} sizes="56px" quality={60} class="heads__thumb" loading="lazy" />}
            <span>
              <strong>{h.title}</strong>
              <small>{h.meta}</small>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: max(640px, min(100svh, 900px));
    color: var(--white);
    background: var(--navy-950);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media,
  .hero__bg {
    position: absolute;
    inset: 0;
  }
  .hero__media {
    z-index: -1;
  }
  .hero__bg {
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }
  .hero__bg.is-active {
    opacity: 1;
  }
  .hero__bg :global(picture),
  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 768px) {
    .hero__bg[data-pos="right"] :global(img) {
      width: 165%;
      max-width: none;
      margin-left: -65%;
    }
    .hero__bg[data-pos="left"] :global(img) {
      width: 140%;
      max-width: none;
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 15 30 / 0.55) 0%, rgb(10 15 30 / 0.1) 18%, rgb(17 34 63 / 0.75) 42%, rgb(17 34 63 / 0.94) 62%, rgb(17 34 63 / 0.98) 100%);
  }
  @media (min-width: 768px) {
    .hero__shade {
      background:
        linear-gradient(90deg, rgb(17 34 63 / 0.97) 0%, rgb(17 34 63 / 0.9) 40%, rgb(17 34 63 / 0.3) 68%, rgb(17 34 63 / 0.1) 100%),
        linear-gradient(180deg, rgb(10 15 30 / 0.5) 0%, rgb(10 15 30 / 0) 18%, rgb(10 15 30 / 0) 60%, rgb(10 15 30 / 0.85) 100%);
    }
  }
  .hero__giant {
    position: absolute;
    left: 50%;
    bottom: -0.16em;
    translate: -50% 0;
    font-size: clamp(5rem, 17vw, 15.5rem);
    font-weight: var(--weight-black);
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.08);
    pointer-events: none;
    user-select: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--space-8);
    padding-top: calc(var(--header-h) + 32px);
    padding-bottom: 104px;
  }
  .hero__slides {
    display: grid;
  }
  .hero__slide {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 894px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out),
      visibility 600ms;
  }
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .hero__title {
    color: var(--white);
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 3.75rem);
    font-weight: var(--weight-semibold);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .hero__title span {
    display: block;
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero__desc {
    max-width: 588px;
    font-size: var(--text-lead);
    font-weight: var(--weight-light);
    color: var(--navy-200);
  }
  .hero__btns {
    display: grid;
    gap: 12px;
    width: 100%;
    margin-top: var(--space-2);
  }
  .hero__btns :global(.btn) {
    width: 100%;
  }
  .hero__ctrl {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero__dots {
    display: flex;
    gap: 6px;
    margin: 0;
  }
  .hero__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
  }
  .hero__dot span {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.35);
    font-size: 0;
    transition:
      width var(--duration-base) var(--ease-out),
      background-color var(--duration-base);
  }
  .hero__dot.is-active span {
    width: 24px;
    background: var(--gold-500);
  }
  .hero__pause {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    color: var(--white);
  }
  .hero__pause .i-play,
  .hero__pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .hero__pause[aria-pressed='true'] .i-play {
    display: block;
  }

  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      padding-bottom: 140px;
    }
    .hero__btns {
      display: flex;
      flex-wrap: wrap;
      width: auto;
      gap: 16px;
    }
    .hero__btns :global(.btn) {
      width: auto;
    }
    .hero__ctrl {
      gap: 8px;
    }
    .hero__dot {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 1px solid rgb(255 255 255 / 0.3);
      transition: border-color var(--duration-base);
    }
    .hero__dot span {
      width: auto;
      height: auto;
      background: none;
      font-size: var(--text-sm);
      color: var(--white);
    }
    .hero__dot.is-active {
      border: 2px solid var(--gold-500);
    }
    .hero__dot.is-active span {
      width: auto;
      background: none;
      font-weight: var(--weight-semibold);
    }
    .hero__pause {
      width: 48px;
      height: 48px;
    }
  }

  /* barra de manchetes */
  .heads {
    position: relative;
    z-index: 2;
    margin-top: -56px;
  }
  .heads__list {
    display: flex;
    gap: 12px;
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 8px;
  }
  .heads__list::-webkit-scrollbar {
    display: none;
  }
  .heads__list li {
    flex: 0 0 min(320px, 82vw);
    scroll-snap-align: start;
  }
  .heads__item {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 16px;
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .heads__item :global(.heads__thumb),
  .heads__item :global(.heads__thumb img) {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 12px;
    object-fit: cover;
  }
  .heads__item strong {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    color: var(--color-text);
  }
  .heads__item small {
    display: block;
    margin-top: 4px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .heads__item:hover strong {
    text-decoration: underline;
  }
  @media (min-width: 1024px) {
    .heads__list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      padding: 0;
      overflow: visible;
      border-radius: var(--radius-3xl);
      background: var(--color-surface);
      box-shadow: var(--shadow-md);
    }
    .heads__list li + li .heads__item {
      border-left: 1px solid var(--color-border);
    }
    .heads__item {
      box-shadow: none;
      border-radius: 0;
      background: none;
      padding: 28px 24px;
    }
  }
</style>
