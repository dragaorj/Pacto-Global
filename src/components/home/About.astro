---
import SectionLabel from '../ui/SectionLabel.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import { type Lang, useT } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const pillarStyle: [IconName, string][] = [
  ['hand-heart', 'var(--tema-direitos-humanos)'],
  ['briefcase', 'var(--tema-trabalho)'],
  ['leaf', 'var(--tema-meio-ambiente)'],
  ['shield', 'var(--tema-anticorrupcao)'],
];
const pillars = [1, 2, 3, 4].map((n) => ({
  icon: pillarStyle[n - 1][0],
  color: pillarStyle[n - 1][1],
  n: t(`pillar.${n}.n` as any),
  t: t(`pillar.${n}.t` as any),
  d: t(`pillar.${n}.d` as any),
}));
const themes = [
  [t('pillar.1.t'), 'var(--tema-direitos-humanos)'],
  [t('pillar.2.t'), 'var(--red-500)'],
  [t('pillar.3.t'), 'var(--teal-600)'],
  [t('pillar.4.t'), 'var(--tema-anticorrupcao)'],
  [t('theme.agenda'), 'var(--gold-500)'],
];
---

<section id="quem-somos" class="about" aria-labelledby="quem-somos-titulo">
  <div class="container">
    <div class="about__row" data-reveal>
      <SectionLabel>{t('about.label')}</SectionLabel>
      <h2 id="quem-somos-titulo" class="about__statement">
        {t('about.p1')} <span>{t('about.p2')}</span>
      </h2>
    </div>
    <ul role="list" class="about__pillars" data-stagger>
      {
        pillars.map((p) => (
          <li class="pillar" style={`--c:${p.color}`}>
            <div class="pillar__top">
              <span class="pillar__icon" aria-hidden="true">
                <Icon name={p.icon} size={24} strokeWidth={1.6} />
              </span>
              <small>{p.n}</small>
            </div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<div class="themes" aria-hidden="true">
  <ul role="list" class="container themes__list">
    {
      themes.map(([label, color]) => (
        <li>
          <span class="themes__dot" style={`background:${color}`} />
          {label}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .about {
    padding-block: calc(var(--section-y) + 8px) var(--section-y);
  }
  .about__row {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  .about__statement {
    font-size: clamp(1.5rem, 1rem + 1.5vw, 2.75rem);
    font-weight: var(--weight-medium);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .about__statement span {
    color: var(--color-text-strong-muted);
  }
  /* 4 pilares: cards iguais, ícone na cor do tema, faixa de cor que cresce no hover */
  .about__pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: var(--space-10) 0 0;
  }
  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-2xl);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition:
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  .pillar::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: var(--c);
    opacity: 0.35;
    transform: scaleX(0.999);
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  .pillar:hover {
    border-color: color-mix(in srgb, var(--c) 35%, var(--color-border));
    background: var(--color-surface);
    transform: translateY(-2px);
  }
  .pillar:hover::after {
    opacity: 1;
  }
  .pillar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .pillar__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--c) 12%, transparent);
    color: var(--c);
  }
  :global([data-theme='dark']) .pillar__icon {
    background: color-mix(in srgb, var(--c) 22%, transparent);
    color: color-mix(in srgb, var(--c) 55%, white);
  }
  .pillar small {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-inline: 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .pillar h3 {
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }
  .pillar p {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  @media (min-width: 640px) {
    .about__pillars {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar,
    .pillar::after {
      transition: none;
    }
  }
  @media (min-width: 1024px) {
    .about__row {
      grid-template-columns: 1fr 3fr;
      column-gap: 24px;
    }
    .about__pillars {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      margin-top: 64px;
    }
    .pillar {
      padding: 28px;
    }
  }

  .themes {
    border-block: 1px solid var(--color-border);
  }
  .themes__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 0;
    padding-block: 24px;
  }
  .themes__list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px 0 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .themes__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  @media (min-width: 1024px) {
    .themes__list {
      justify-content: space-between;
      padding-block: 32px;
    }
    .themes__list li {
      height: auto;
      padding: 0;
      border: 0;
      gap: 12px;
      font-size: 1.375rem;
    }
    .themes__dot {
      width: 10px;
      height: 10px;
    }
  }
</style>
