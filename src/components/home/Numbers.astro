---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { type Lang, useT } from '../../i18n/ui';

interface Props {
  lang: Lang;
  values: string[];
  image?: ImageMetadata;
}
const { lang, values, image } = Astro.props;
const t = useT(lang);
const labels = [t('numbers.companies'), t('numbers.orgs'), t('numbers.networks'), t('numbers.participants')];
const plus = [true, false, false, true];
---

<section id="magnitude" class="num" aria-labelledby="magnitude-titulo">
  <div class="container num__grid">
    {
      image && (
        <div class="num__photo" data-reveal>
          <Picture src={image} alt="" formats={['avif', 'webp']} widths={[400, 640, 800]} sizes="(min-width: 1024px) 384px, 100vw" quality={58} loading="lazy" />
        </div>
      )
    }
    <div class="num__content">
      <header class="num__head" data-reveal>
        <SectionLabel>{t('numbers.label')}</SectionLabel>
        <h2 id="magnitude-titulo" data-two-tone>{t('numbers.t1')} <span>{t('numbers.t2')}</span></h2>
      </header>
      <dl class="num__list" data-stagger>
        {
          values.slice(0, 4).map((v, i) => (
            <div class="num__item">
              <dt class="visually-hidden">{labels[i]}</dt>
              <dd class="num__value">
                <span data-count={v}>{v}</span>
                {plus[i] && <sup>+</sup>}
              </dd>
              <dd class="num__label">{labels[i]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .num {
    padding-block: var(--section-y);
  }
  .num__grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }
  .num__photo :global(picture),
  .num__photo :global(img) {
    width: 100%;
    aspect-ratio: 35 / 24;
    object-fit: cover;
    border-radius: var(--radius-2xl);
  }
  .num__content {
    display: grid;
    gap: var(--space-10);
  }
  .num__head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .num__head h2 {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    font-weight: var(--weight-semibold);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .num__head h2 span {
    display: block;
    color: var(--color-text-strong-muted);
  }
  .num__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
    margin: 0;
  }
  .num__item {
    padding-top: 16px;
    border-top: 1px solid var(--color-border-strong);
  }
  .num__item dd {
    margin: 0;
  }
  .num__value {
    display: flex;
    align-items: flex-start;
    gap: 2px;
    font-size: clamp(2.75rem, 1.6rem + 3.4vw, 4.5rem);
    font-weight: var(--weight-light);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .num__value sup {
    font-size: 0.38em;
    font-weight: var(--weight-semibold);
    color: var(--color-action);
    line-height: 1;
    margin-top: 0.15em;
  }
  .num__label {
    margin-top: 8px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (min-width: 1024px) {
    .num__grid {
      grid-template-columns: 384px 1fr;
      column-gap: 24px;
    }
    .num__photo :global(img) {
      aspect-ratio: 384 / 520;
    }
    .num__content {
      padding-left: 102px;
      gap: 40px;
    }
    .num__list {
      gap: 40px 24px;
    }
    .num__label {
      font-size: var(--text-body);
    }
  }
</style>
